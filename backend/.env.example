# Application
APP_NAME=Art Studio Management
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api

# Server
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ZendBX Configuration
ZENDBX_URL=your_zendbx_url
ZENDBX_ANON_KEY=your_zendbx_anon_key
ZENDBX_SERVICE_KEY=your_zendbx_service_key
DATABASE_URL=postgresql://user:password@host:5432/art_studio

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@artstudio.com
SMTP_FROM_NAME=Art Studio

# Redis (for background tasks)
REDIS_URL=redis://localhost:6379/0

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=INFO

# Automation
AUTOMATION_SECRET=change-this-to-a-secure-random-string-in-production
ADMIN_EMAIL=admin@artfully.com
APP_TIMEZONE=Asia/Kolkata
